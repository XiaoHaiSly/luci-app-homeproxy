#!/usr/bin/ucode

'use strict';

import { access, error, lstat, popen, readfile, writefile } from 'fs';
import { cursor } from 'uci';
import { isBinary } from '/etc/homeproxy/scripts/homeproxy.uc';

function shellquote(s) {
	return `'${replace(s, "'", "'\\''")}'`;
}

function hasKernelModule(kmod) {
	return (system(sprintf('[ -e "/lib/modules/$(uname -r)"/%s ]', shellquote(kmod))) === 0);
}

const HP_DIR = '/etc/homeproxy';
const RUN_DIR = '/var/run/homeproxy';
const JOBS_DIR = `${RUN_DIR}/jobs`;

function job_esc(s) {
	return replace(replace('' + (s ?? ''), '\\', '\\\\'), '"', '\\"');
}

function job_write(name, state, stage, message, version) {
	system(`mkdir -p ${shellquote(JOBS_DIR)}`);

	let fields = [ `"ts":"${time()}"`, `"state":"${job_esc(state)}"`, `"stage":"${job_esc(stage)}"` ];
	if (message) push(fields, `"message":"${job_esc(message)}"`);
	if (version) push(fields, `"version":"${job_esc(version)}"`);

	const path = `${JOBS_DIR}/${name}.json`;
	writefile(`${path}.tmp`, '{' + join(',', fields) + '}');
	system(`mv -f ${shellquote(path + '.tmp')} ${shellquote(path)}`);
}

function job_read(name) {
	const raw = readfile(`${JOBS_DIR}/${name}.json`);
	if (!raw)
		return { state: 'idle' };

	try {
		const parsed = json(raw);
		return (type(parsed) === 'object') ? parsed : { state: 'idle' };
	} catch (e) {
		return { state: 'idle' };
	}
}

function core_cache_paths() {
	let paths = [
		`${HP_DIR}/cache/core_cache.db`,
		`${HP_DIR}/cache/cache.db`,
		`${RUN_DIR}/cache.db`
	];

	for (let run_conf in [ `${RUN_DIR}/sing-box-core.json`, `${RUN_DIR}/sing-box-c.json` ]) {
		if (!access(run_conf)) continue;
		let conf;
		try { conf = json(readfile(run_conf)); } catch (e) { conf = null; }
		const p = conf?.experimental?.cache_file?.path;
		if (p && index(paths, p) < 0)
			push(paths, p);
	}

	return paths;
}

const SINGBOX_BIN      = '/usr/bin/sing-box';
const CORE_BACKUP_DIR   = `${HP_DIR}/core-backup`;
const CORE_BACKUP_BIN   = `${CORE_BACKUP_DIR}/sing-box.orig`;

function core_detect_arch() {
	const os_rel = readfile('/etc/os-release') || '';
	const m = match(os_rel, /OPENWRT_ARCH="?([^"\n]+)"?/);
	return m ? trim(m[1]) : '';
}

const CORE_GOARCH_MAP = {
	'x86_64': 'amd64',
	'i386_pentium4': '386', 'i386_pentium-mmx': '386',
	'aarch64_generic': 'arm64', 'aarch64_cortex-a53': 'arm64',
	'aarch64_cortex-a72': 'arm64', 'aarch64_cortex-a76': 'arm64',
	'arm_cortex-a7': 'armv7', 'arm_cortex-a7_neon-vfpv4': 'armv7',
	'arm_cortex-a7_vfpv4': 'armv7', 'arm_cortex-a8_vfpv3': 'armv7',
	'arm_cortex-a9': 'armv7', 'arm_cortex-a9_vfpv3-d16': 'armv7',
	'arm_cortex-a15_neon-vfpv4': 'armv7',
	'arm_arm1176jzf-s_vfp': 'armv6', 'arm_mpcore': 'armv6',
	'arm_xscale': 'armv5', 'arm_arm926ej-s': 'armv5', 'arm_fa526': 'armv5',
	'mipsel_24kc': 'mipsle', 'mipsel_74kc': 'mipsle', 'mipsel_mips32': 'mipsle',
	'mips_24kc': 'mips', 'mips_4kec': 'mips', 'mips_mips32': 'mips',
	'mips64_octeonplus': 'mips64', 'mips64_mips64r2': 'mips64',
	'mips64el_mips64r2': 'mips64le',
	'riscv64_generic': 'riscv64',
	'loongarch64_generic': 'loong64'
};

function core_goarch(owrt_arch) {
	if (owrt_arch in CORE_GOARCH_MAP) return CORE_GOARCH_MAP[owrt_arch];
	if (match(owrt_arch, /^aarch64/)) return 'arm64';
	if (match(owrt_arch, /^arm_cortex/)) return 'armv7';
	if (match(owrt_arch, /^mipsel/)) return 'mipsle';
	if (match(owrt_arch, /^mips_/)) return 'mips';
	if (match(owrt_arch, /^mips64el/)) return 'mips64le';
	if (match(owrt_arch, /^mips64/)) return 'mips64';
	if (match(owrt_arch, /^riscv64/)) return 'riscv64';
	if (match(owrt_arch, /^loongarch64/)) return 'loong64';
	if (match(owrt_arch, /^i386/)) return '386';
	return null;
}

function core_gh_token_header() {
	let token = null;
	const fd = popen('uci -q get homeproxy.config.github_token 2>/dev/null');
	if (fd) { token = trim(fd.read('all')); fd.close(); }
	return (token && length(token)) ? `-H ${shellquote(`Authorization: Bearer ${token}`)}` : '';
}

function core_fetch_json(url) {
	const token_hdr = core_gh_token_header();
	const fd = popen(`/usr/bin/curl -4 -fsSL --connect-timeout 10 --max-time 15 ${token_hdr} ${shellquote(url)} 2>/dev/null`);
	if (!fd) return null;
	const raw = trim(fd.read('all')); fd.close();
	if (!length(raw)) return null;

	try { return json(raw); } catch(e) { return null; }
}

function core_fetch_release(repo, channel) {
	if (channel === 'latest') {
		const data = core_fetch_json('https://api.github.com/repos/' + repo + '/releases?per_page=1');
		return (type(data) === 'array' && length(data)) ? data[0] : null;
	}

	const data = core_fetch_json('https://api.github.com/repos/' + repo + '/releases/latest');
	if (data?.tag_name) return data;

	const list = core_fetch_json('https://api.github.com/repos/' + repo + '/releases?per_page=30');
	if (type(list) === 'array')
		for (let rel in list)
			if (rel?.tag_name && !rel.prerelease && !rel.draft)
				return rel;

	return null;
}

function core_repo(core) {
	return 'SagerNet/sing-box';
}

function core_arch_matches(filename, goarch) {
	return !!match(filename, regexp('(^|[-_.])' + goarch + '($|[-_.])'));
}

const methods = {
	acllist_read: {
		args: { type: 'type' },
		call: function(req) {
			if (index(['direct_list', 'proxy_list'], req.args?.type) === -1)
				return { content: null, error: 'illegal type' };

			const filecontent = readfile(`${HP_DIR}/resources/${req.args?.type}.txt`);
			return { content: filecontent };
		}
	},
	acllist_write: {
		args: { type: 'type', content: 'content' },
		call: function(req) {
			if (index(['direct_list', 'proxy_list'], req.args?.type) === -1)
				return { result: false, error: 'illegal type' };

			const file = `${HP_DIR}/resources/${req.args?.type}.txt`;
			let content = req.args?.content;

			if (content) {
				content = trim(content);
				content = replace(content, /\r\n?/g, '\n');
				if (!match(content, /\n$/))
					content += '\n';
			}

			system(`mkdir -p ${HP_DIR}/resources`);
			writefile(file, content);

			return { result: true };
		}
	},

	certificate_write: {
		args: { filename: 'filename' },
		call: function(req) {
			const writeCertificate = (filename, priv) => {
				const tmpcert = '/tmp/homeproxy_certificate.tmp';
				const filestat = lstat(tmpcert);

				if (!filestat || filestat.type !== 'file' || filestat.size <= 0) {
					system(`rm -f ${tmpcert}`);
					return { result: false, error: 'empty certificate file' };
				}

				let filecontent = readfile(tmpcert);
				if (isBinary(filecontent)) {
					system(`rm -f ${tmpcert}`);
					return { result: false, error: 'illegal file type: binary' };
				}

				const beg = priv ? /^-----BEGIN (RSA|EC) PRIVATE KEY-----$/ : /^-----BEGIN CERTIFICATE-----$/,
				      end = priv ? /^-----END (RSA|EC) PRIVATE KEY-----$/ : /^-----END CERTIFICATE-----$/,
				      lines = split(trim(filecontent), /[\r\n]/);
				let start = false, i;

				for (i = 0; i < length(lines); i++) {
					if (match(lines[i], beg))
						start = true;
					else if (start && !b64dec(lines[i]) && length(lines[i]) !== 64)
						break;
				}

				if (!start || i < length(lines) - 1 || !match(lines[i], end)) {
					system(`rm -f ${tmpcert}`);
					return { result: false, error: 'this does not look like a correct PEM file' };
				}

				filecontent = trim(filecontent);
				filecontent = replace(filecontent, /\r\n?/g, '\n');
				if (!match(filecontent, /\n$/))
					filecontent += '\n';

				system(`mkdir -p ${HP_DIR}/certs`);
				writefile(`${HP_DIR}/certs/${filename}.pem`, filecontent);
				system(`rm -f ${tmpcert}`);

				return { result: true };
			};

			const filename = req.args?.filename;
			switch (filename) {
			case 'client_ca':
			case 'server_publickey':
				return writeCertificate(filename, false);
				break;
			case 'server_privatekey':
				return writeCertificate(filename, true);
				break;
			default:
				return { result: false, error: 'illegal cerificate filename' };
				break;
			}
		}
	},

	connection_check: {
		args: { site: 'site' },
		call: function(req) {
			let url;
			switch(req.args?.site) {
			case 'baidu':
				url = 'http://connect.rom.miui.com/generate_204';
				break;
			case 'google':
				url = 'http://www.google.com/generate_204';
				break;
			default:
				return { result: false, error: 'illegal site' };
				break;
			}

			return { result: (system(`/usr/bin/curl -4 -o /dev/null -s -f --connect-timeout 3 --max-time 3 ${shellquote(url)} 2>/dev/null`, 3100) === 0) };
		}
	},

	log_clean: {
		args: { type: 'type' },
		call: function(req) {
			if (!(req.args?.type in ['homeproxy', 'sing-box-c', 'sing-box-s']))
				return { result: false, error: 'illegal type' };

			const filestat = lstat(`${RUN_DIR}/${req.args?.type}.log`);
			if (filestat)
				writefile(`${RUN_DIR}/${req.args?.type}.log`, '');
			return { result: true };
		}
	},

	singbox_generator: {
		args: { type: 'type', params: 'params' },
		call: function(req) {
			if (!(req.args?.type in ['ech-keypair', 'uuid', 'reality-keypair', 'vapid-keypair', 'wg-keypair']))
				return { result: false, error: 'illegal type' };

			const type = req.args?.type;
			let result = {};

			const raw_params = trim(req.args?.params || '');
			let params_arg = '';
			if (raw_params !== '') {
				if (type !== 'ech-keypair')
					return { result: false, error: 'illegal params' };
				if (!match(raw_params, /^[A-Za-z0-9]([A-Za-z0-9-]{0,62}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,62}[A-Za-z0-9])?)*$/))
					return { result: false, error: 'illegal params' };
				params_arg = ' ' + shellquote(raw_params);
			}

			const fd = popen('/usr/bin/sing-box generate ' + shellquote(type) + params_arg);
			if (fd) {
				let ech_cfg_set = false;
				let ech_key_set = false;

				for (let line = fd.read('line'); length(line); line = fd.read('line')) {
					if (type === 'uuid')
						result.uuid = trim(line);
					else if (type in ['reality-keypair', 'vapid-keypair', 'wg-keypair']) {
						let priv = match(trim(line), /PrivateKey: (.*)/);
						if (priv)
							result.private_key = priv[1];
						let pub = match(trim(line), /PublicKey: (.*)/);
						if (pub)
							result.public_key = pub[1];
					} else if (type in ['ech-keypair']) {
						if (trim(line) === '-----BEGIN ECH CONFIGS-----')
							ech_cfg_set = true;
						else if (trim(line) === '-----BEGIN ECH KEYS-----')
							ech_key_set = true;

						if (ech_cfg_set)
							result.ech_cfg = result.ech_cfg ? result.ech_cfg + '\n' + trim(line) : trim(line) ;
						if (ech_key_set)
							result.ech_key = result.ech_key ? result.ech_key + '\n' + trim(line) : trim(line) ;

						if (trim(line) === '-----END ECH CONFIGS-----')
							ech_cfg_set = false;
						else if (trim(line) === '-----END ECH KEYS-----')
							ech_key_set = false;
					}
				}

				fd.close();
			}

			return { result };
		}
	},

	singbox_get_features: {
		call: function() {
			let features = {};

			const fd = popen('/usr/bin/sing-box version');
			if (fd) {
				for (let line = fd.read('line'); length(line); line = fd.read('line')) {
					if (match(trim(line), /^sing-box version (.*)/))
						features.version = match(trim(line), /^sing-box version (.*)/)[1];

					let tags = match(trim(line), /^Tags: (.*)/);
					if (tags)
						for (let i in split(tags[1], ','))
							features[i] = true;
				}

				fd.close();
			}

			features.hp_has_ip_full = access('/usr/libexec/ip-full');
			features.hp_has_tcp_brutal = hasKernelModule('brutal.ko');
			features.hp_has_tun = hasKernelModule('tun.ko') || access('/etc/modules.d/30-tun');

			return features;
		}
	},

	current_node_get: {
		call: function() {
			const uci = cursor();
			uci.load('homeproxy');

			const formatNode = (section_id, fallback_label) => {
				if (!section_id || section_id in ['nil', 'same'])
					return { id: section_id, label: fallback_label || section_id, type: null };

				const section = uci.get_all('homeproxy', section_id);
				if (!section || section['.type'] !== 'node')
					return { id: section_id, label: fallback_label || section_id, type: null };

				const address = trim(section.address || '');
				const port = trim(section.port || '');
				const label = trim(section.label || '') || ((address && port) ? `${address}:${port}` : section_id);
				return { id: section_id, label, type: section.type || null };
			};

			const main_node = trim(uci.get('homeproxy', 'config', 'main_node') || 'nil');
			const main_udp_node = trim(uci.get('homeproxy', 'config', 'main_udp_node') || 'nil');

			const main_needs_api = (main_node === 'urltest');
			const udp_needs_api = (main_udp_node === 'urltest');

			let data = null, api_error = null;
			if (main_needs_api || udp_needs_api) {
				const dashboard_port = int(uci.get('homeproxy', 'config', 'dashboard_port')) || 9096;
				const clash_api_port = dashboard_port + 1;

				const fd = popen(`/usr/bin/curl -fsS --connect-timeout 1 --max-time 2 http://127.0.0.1:${clash_api_port}/proxies 2>/dev/null`);
				if (fd) {
					let payload = '', line;
					for (line = fd.read('line'); length(line); line = fd.read('line'))
						payload += line;
					fd.close();

					try { data = json(payload); } catch (e) {}
				}

				if (!data)
					api_error = 'clash_api_unavailable';
			}

			const resolveGroupTag = (group_tag) => {
				const group = data?.proxies?.[group_tag];
				const tag = trim(group?.now || '');
				if (!tag)
					return { active: { id: 'urltest', label: 'URLTest', type: 'urltest' }, error: 'missing_current_proxy', delay: null };

				const history = data?.proxies?.[tag]?.history;
				const delay = (type(history) === 'array' && length(history)) ? history[length(history) - 1]?.delay : null;

				let found = null;
				uci.foreach('homeproxy', 'node', (section) => {
					if (found) return;
					if (trim(section.label || '') === tag)
						found = section;
				});

				if (found)
					return { active: { id: found['.name'], label: tag, type: found.type || null }, error: null, delay };

				const matched = match(tag, /^cfg-(.*)-out$/);
				const section_id = matched ? matched[1] : tag;

				return { active: formatNode(section_id, tag), error: null, delay };
			};

			let active, error, delay = null;
			if (!main_needs_api) {
				active = formatNode(main_node, (main_node === 'nil') ? 'Disable' : null);
				error = null;
			} else if (api_error) {
				active = { id: 'urltest', label: 'URLTest', type: 'urltest' };
				error = api_error;
			} else {
				const r = resolveGroupTag('main-out');
				active = r.active;
				error = r.error;
				delay = r.delay;
			}

			let udp_active = null, udp_error = null, udp_delay = null;
			if (udp_needs_api) {
				if (api_error) {
					udp_active = { id: 'urltest', label: 'URLTest', type: 'urltest' };
					udp_error = api_error;
				} else {
					const r = resolveGroupTag('main-udp-out');
					udp_active = r.active;
					udp_error = r.error;
					udp_delay = r.delay;
				}
			}

			return {
				mode: main_node,
				active,
				error,
				delay,
				udp_mode: main_udp_node,
				udp_active,
				udp_error,
				udp_delay
			};
		}
	},

	core_info: {
		call: function() {
			const arch = core_detect_arch();

			let version = null, vendor = null;
			const fd = popen(`${SINGBOX_BIN} version 2>/dev/null`);
			if (fd) {
				const out = fd.read('all'); fd.close();
				const m = match(out, /sing-box version ([^\s]+)/);
				if (m) {
					version = m[1];
					vendor = 'official';
				}
			}

			return {
				arch,
				installed: !!version,
				version, vendor,
				has_backup: !!access(CORE_BACKUP_BIN)
			};
		}
	},

	core_check_remote: {
		args: { core: 'core', channel: 'channel' },
		call: function(req) {
			const core = req.args?.core;
			const channel = (req.args?.channel === 'stable') ? 'stable' : 'latest';
			if (core !== 'official')
				return { error: 'illegal core' };

			const data = core_fetch_release(core_repo(core), channel);
			if (!data)
				return { error: 'failed to contact GitHub API' };
			if (!data?.tag_name)
				return { error: (channel === 'stable')
					? 'no stable (non-prerelease) release found for this core — try the Latest channel instead'
					: 'could not read tag_name (rate-limited? set a GitHub token in Resources management)' };

			return { tag: data.tag_name, version: replace(data.tag_name, /^v/, ''), prerelease: !!data.prerelease };
		}
	},

	core_update_start: {
		args: { channel: 'channel' },
		call: function(req) {
			const channel = (req.args?.channel === 'stable') ? 'stable' : 'latest';
			const current = job_read('core_official');
			if (current?.state === 'running')
				return { result: false, error: 'already updating' };

			job_write('core_official', 'running', 'preparing');
			system(`/usr/bin/ucode -S ${HP_DIR}/scripts/update_core.uc ${shellquote(channel)} >/dev/null 2>&1 &`);

			return { result: true };
		}
	},

	core_update_status: {
		call: function() {
			return job_read('core_official');
		}
	},

	core_restore: {
		call: function() {
			if (!access(CORE_BACKUP_BIN))
				return { result: false, error: 'no firmware-shipped backup found' };

			const restore_tmp = `${SINGBOX_BIN}.restore`;
			system(`rm -f ${shellquote(restore_tmp)}`);
			const staged = system(`cp -f ${shellquote(CORE_BACKUP_BIN)} ${shellquote(restore_tmp)} && chmod 755 ${shellquote(restore_tmp)}`) === 0;
			if (!staged || system(`${shellquote(restore_tmp)} version -n >/dev/null 2>&1`, 15000) !== 0) {
				system(`rm -f ${shellquote(restore_tmp)}`);
				return { result: false, error: 'backup executable failed validation' };
			}

			system('/etc/init.d/homeproxy stop >/dev/null 2>&1');
			const ok = system(`mv -f ${shellquote(restore_tmp)} ${shellquote(SINGBOX_BIN)}`) === 0;
			if (ok)
				for (let p in core_cache_paths())
					system(`rm -f ${shellquote(p)} 2>/dev/null`);
			system('/etc/init.d/homeproxy start >/dev/null 2>&1');

			return ok ? { result: true } : { result: false, error: 'restore failed' };
		}
	},

	resources_get_version: {
		args: { type: 'type' },
		call: function(req) {
			const raw = readfile(`${HP_DIR}/resources/${req.args?.type}.ver`);
			if (raw === null)
				return { error: 'not found' };
			const version = trim(raw);
			return length(version) ? { version: version } : { error: 'not found' };
		}
	},
	resources_update_start: {
		args: { type: 'type' },
		call: function(req) {
			const type = req.args?.type;
			if (index(['dashboard'], type) === -1)
				return { result: false, error: 'illegal type' };

			job_write(`res_${type}`, 'running', 'checking');
			system(`${HP_DIR}/scripts/update_resources.sh ${shellquote(type)} >/dev/null 2>&1 &`);

			return { result: true };
		}
	},

	resources_update_status: {
		args: { type: 'type' },
		call: function(req) {
			const type = req.args?.type;
			if (index(['dashboard'], type) === -1)
				return { state: 'idle' };

			return job_read(`res_${type}`);
		}
	}
};

return { 'luci.homeproxy': methods };
